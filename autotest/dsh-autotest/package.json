{
  "name": "dsh-autotest",
  "description": "鸿蒙三方库 AutoTest 平台 — DeepSeek Harness 服务端插件（用例库/任务/执行计划/设备，复用 ctx.llm 与 ctx.webServer）",
  "version": "0.1.58",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:data": "node scripts/verify-data-integrity.mjs",
    "verify:api": "node scripts/verify-api-guard.mjs",
    "verify:explorer": "node scripts/verify-explorer-rules.mjs",
    "verify:repo-paths": "node scripts/verify-repo-paths.mjs",
    "verify:sheet": "node scripts/verify-library-sheet.mjs",
    "verify:api-extract": "node scripts/verify-api-extract.mjs",
    "verify:coverage": "node scripts/verify-coverage-matrix.mjs",
    "verify:case-plan": "node scripts/verify-case-plan.mjs",
    "verify:testability": "node scripts/verify-testability.mjs",
    "verify:oracle": "node scripts/verify-oracle.mjs",
    "verify:automation": "node scripts/verify-automation.mjs",
    "verify:binding": "node scripts/verify-script-binding.mjs",
    "verify:knowledge": "node scripts/verify-knowledge.mjs",
    "verify:oracle-runtime": "node scripts/verify-oracle-runtime.mjs",
    "verify:contract": "npm run build && node scripts/verify-step-contract.mjs",
    "verify:all": "npm run build && npm run verify:data && npm run verify:api && npm run verify:explorer && npm run verify:repo-paths && npm run verify:sheet && npm run verify:api-extract && npm run verify:coverage && npm run verify:case-plan && npm run verify:testability && npm run verify:oracle && npm run verify:automation && npm run verify:binding && npm run verify:knowledge && npm run verify:oracle-runtime && node scripts/verify-step-contract.mjs",
    "db:init": "tsx src/db/init.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11",
    "better-sqlite3": "^11.10.0",
    "ioredis": "^5.11.1",
    "mysql2": "^3.24.2",
    "node-cron": "^3.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "xlsx": "^0.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.7"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.28.2": true,
    "tsx@4.23.12": true
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-attachment": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-brand": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-timeout": "^0.1.0-rc.7"
  }
}
