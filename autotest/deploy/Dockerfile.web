# AutoTest 独立版前端镜像（A3 · 设计 §13.5，拓扑 B：Nginx 同域反代）
# 与 Dockerfile 同一构建上下文（autotest 仓库根）：
#   docker build -f deploy/Dockerfile.web -t autotest-web .
# 镜像内 Nginx：
#   - /           → dist/web 静态 SPA（config.js 为部署期可编辑文件，禁止长缓存）
#   - /api/autotest/ → 反代 server:3280（同域，无 CORS）
#   - /api/autotest/ws → WS Upgrade 反代
FROM node:20-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY web/package.json web/package.json
COPY shared/package.json shared/package.json
COPY dsh-autotest/package.json dsh-autotest/package.json
RUN npm ci
COPY . .
RUN npm run build:standalone

FROM nginx:1.27-alpine
COPY deploy/web.nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dsh-autotest/dist/web /usr/share/nginx/html
# config.js 是部署期可编辑文件：Nginx 容器里也能改（docker exec / 挂载覆盖），改完即生效（no-cache）
