# AutoTest 独立版裸机 Nginx 配置示例（A3 · 设计 §13.4，拓扑 B：同域反代）。
# 适用：Nginx 与 autotest 服务端同机部署（服务端 `npm start` 监听 127.0.0.1:3280）。
# Docker 部署请用 deploy/web.nginx.conf（Dockerfile.web 已内置）。
#
# 关键点：
#   1. 静态 SPA：dist/web（含部署期可编辑的 config.js，必须 no-cache）；
#   2. /api/autotest/ 反代 3280；/api/autotest/ws 走 HTTP Upgrade（正则段，优先于前缀段）；
#   3. 同域反代下浏览器 Origin 与 Host 一致，后端同源闸门天然放行，无需 CORS 白名单；
#   4. 跨域拓扑 C 不要反代 API 段，改用 AUTOTEST_CORS_ORIGINS 白名单 + config.js 指向 API 绝对地址。
server {
    listen 80;
    server_name autotest.example.com;

    # 前端产物（autotest 仓库执行 npm run build:standalone 后生成）
    root /opt/autotest/dsh-autotest/dist/web;
    index index.html;

    # 部署期可编辑的 runtime config：改 apiBase/wsBase 即生效，不需要 no-cache 之外的任何缓存策略
    location = /config.js {
        add_header Cache-Control "no-cache";
    }

    # 带 hash 的打包资产可长缓存
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # WebSocket（正则 location 优先于前缀 location，须放在普通 API 段之前定义）
    location ~ ^/api/autotest/ws$ {
        proxy_pass http://127.0.0.1:3280;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # 普通 API（同域反代：无 CORS）
    location /api/autotest/ {
        proxy_pass http://127.0.0.1:3280;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;   # LLM 分析/执行类接口耗时较长
    }

    # SPA 回退（hash 路由之外的路径回 index.html）
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}

# ---- 拓扑 C（跨域分离）参考：API 域名只暴露 API，不放静态文件 ----
